@model List<ReeferSystem.Models.YardSlotModel>
@{
    ViewData["Title"] = "Yard Slot Architecture & Layout Management";
}

<div class="app-wrapper" style="overflow-y: auto; height: 100vh;">
    <!-- Navigation Bar -->
    <header class="top-nav">
        <div class="brand-section">
            <div class="brand-logo-icon">
                <i class="bi bi-diagram-3-fill"></i>
            </div>
            <div>
                <div class="brand-title">YARD SLOTS <span style="color: var(--color-cyan);">MANAGEMENT</span></div>
                <div class="brand-tag">Oracle Database • Pkg_Front_End Procedures</div>
            </div>
        </div>

        <div class="nav-actions">
            <a href="/" class="btn btn-sm btn-outline-info">
                <i class="bi bi-grid-3x3-gap me-1"></i> Back to Yard View
            </a>
            <button class="theme-toggle-btn" id="themeToggleBtn" onclick="toggleTheme()" title="Switch theme">
                <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                <span id="themeLabel">Dark Mode</span>
            </button>
        </div>
    </header>

    <div class="p-4">
        <!-- Breadcrumb / Header Banner -->
        <div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
            <div>
                <h4 class="fw-bold mb-1" style="color: var(--text-highlight);">
                    <i class="bi bi-layers-half text-info me-2"></i>Yard Slot & Stack Configuration
                </h4>
                <p class="text-muted small mb-0">
                    Define and manage yard slot layouts, stack rows, dimensions, and tier coordinates backed by Oracle <code>yard_slots</code> table.
                </p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-sm btn-primary" onclick="resetFormToNew()">
                    <i class="bi bi-plus-circle me-1"></i> New Slot Definition
                </button>
                <button class="btn btn-sm btn-outline-secondary" onclick="reloadSlotsTable()">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh Data
                </button>
            </div>
        </div>

        <div class="row g-4 mb-4">
            <!-- 1. Slot Form Card (Insert / Update) -->
            <div class="col-lg-6">
                <div class="detail-card">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                        <h5 class="fw-bold mb-0 text-info" id="formHeaderTitle">
                            <i class="bi bi-plus-square me-2"></i>Insert New Yard Slot
                        </h5>
                        <span class="badge-custom text-warning" id="formModeBadge">MODE: INSERT</span>
                    </div>

                    <form id="yardSlotForm" onsubmit="handleSlotFormSubmit(event)">
                        <input type="hidden" id="slotUseq" value="0">

                        <div class="row g-3">
                            <!-- Slot Name & Type -->
                            <div class="col-md-7 col-12">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    Yard Slot Name <span class="text-danger">*</span>
                                </label>
                                <input type="text" id="slotName" class="form-control theme-select" placeholder="e.g. STACK-AB, BAY-01, NORTH-REEFER" required>
                                <small class="text-muted" style="font-size: 0.72rem;">Mapped to <code>p_yard_slot_name</code></small>
                            </div>

                            <div class="col-md-5 col-12">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    Yard Slot Type <span class="text-danger">*</span>
                                </label>
                                <select id="slotType" class="form-select theme-select">
                                    <option value="STANDARD">STANDARD (DRY)</option>
                                    <option value="REEFER">REEFER (COLD CHAIN)</option>
                                    <option value="HAZMAT">HAZMAT (DANGEROUS)</option>
                                    <option value="EMPTY">EMPTY DEPOT</option>
                                    <option value="TRANSHIPMENT">TRANSHIPMENT</option>
                                </select>
                                <small class="text-muted" style="font-size: 0.72rem;">Mapped to <code>p_yard_slot_type</code></small>
                            </div>

                            <!-- Stack Rows, Y-Axis, X-Axis -->
                            <div class="col-md-4 col-12">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    Stack Rows <span class="text-danger">*</span>
                                </label>
                                <input type="number" id="stackRows" class="form-control theme-select" value="14" min="1" max="100" oninput="updatePreview()" required>
                                <small class="text-muted" style="font-size: 0.72rem;"><code>p_stack_rows</code> (Depth)</small>
                            </div>

                            <div class="col-md-4 col-6">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    Y-Axis (Tiers) <span class="text-danger">*</span>
                                </label>
                                <input type="number" id="yAxis" class="form-control theme-select" value="6" min="1" max="12" oninput="updatePreview()" required>
                                <small class="text-muted" style="font-size: 0.72rem;"><code>p_y_axis</code> (Height)</small>
                            </div>

                            <div class="col-md-4 col-6">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    X-Axis (Cols) <span class="text-danger">*</span>
                                </label>
                                <input type="number" id="xAxis" class="form-control theme-select" value="6" min="1" max="26" oninput="updatePreview()" required>
                                <small class="text-muted" style="font-size: 0.72rem;"><code>p_x_axis</code> (Width)</small>
                            </div>

                            <!-- Coordinate Start Directions -->
                            <div class="col-md-4 col-6">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    X-Axis Start From
                                </label>
                                <select id="xAxisStart" class="form-select theme-select" onchange="updatePreview()">
                                    <option value="A">Column A (Alphabetic A..Z)</option>
                                    <option value="1">Column 1 (Numeric 1..N)</option>
                                    <option value="LEFT">LEFT (Port Side)</option>
                                    <option value="RIGHT">RIGHT (Starboard)</option>
                                </select>
                                <small class="text-muted" style="font-size: 0.72rem;"><code>p_x_axis_start_from</code></small>
                            </div>

                            <div class="col-md-4 col-6">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    Y-Axis Start From
                                </label>
                                <select id="yAxisStart" class="form-select theme-select" onchange="updatePreview()">
                                    <option value="1">Tier 1 (Base/Bottom up)</option>
                                    <option value="TOP">TOP (Stack Top down)</option>
                                </select>
                                <small class="text-muted" style="font-size: 0.72rem;"><code>p_y_axis_start_from</code></small>
                            </div>

                            <div class="col-md-2 col-6">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    Active
                                </label>
                                <select id="slotActive" class="form-select theme-select">
                                    <option value="Y">Y (Active)</option>
                                    <option value="N">N (Inactive)</option>
                                </select>
                                <small class="text-muted" style="font-size: 0.72rem;"><code>p_active</code></small>
                            </div>

                            <div class="col-md-2 col-6">
                                <label class="form-label small fw-bold" style="color: var(--text-secondary);">
                                    User ID
                                </label>
                                <input type="text" id="slotUserId" class="form-control theme-select" value="ADMIN">
                                <small class="text-muted" style="font-size: 0.72rem;"><code>p_user_id</code></small>
                            </div>
                        </div>

                        <!-- Capacity Summary calculation -->
                        <div class="mt-3 p-2 rounded card-subbox d-flex justify-content-between align-items-center">
                            <span class="small text-muted">Calculated Slot Capacity:</span>
                            <span class="fw-bold text-info" id="capacityPill">504 TEU (14 Rows × 6 Tiers × 6 Cols)</span>
                        </div>

                        <!-- Submit Buttons -->
                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-success flex-fill fw-bold" id="btnSubmitSlot">
                                <i class="bi bi-check-circle me-1"></i> Save Yard Slot (Insert)
                            </button>
                            <button type="button" class="btn btn-outline-secondary" onclick="resetFormToNew()">
                                <i class="bi bi-x-circle me-1"></i> Cancel / Clear
                            </button>
                        </div>
                    </form>
                </div>
            </div>

            <!-- 2. Live Interactive Layout Preview Card -->
            <div class="col-lg-6">
                <div class="detail-card h-100 d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--border-subtle) !important;">
                        <h5 class="fw-bold mb-0" style="color: var(--text-highlight);">
                            <i class="bi bi-eye text-warning me-2"></i>Live Layout & Matrix Preview
                        </h5>
                        <span class="badge bg-info text-dark" id="previewBadge">STACK-AB &bull; 6x6 Matrix</span>
                    </div>

                    <div class="flex-grow-1 d-flex flex-column justify-content-center align-items-center p-3">
                        <div id="previewCard" class="yard-block w-100" style="max-width: 440px;">
                            <!-- Dynamically generated via updatePreview() -->
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. Existing Yard Slots Data Table Card -->
        <div class="detail-card">
            <div class="d-flex justify-content-between align-items-center mb-3 flex-wrap gap-2">
                <div>
                    <h5 class="fw-bold mb-0" style="color: var(--text-highlight);">
                        <i class="bi bi-table text-info me-2"></i>Configured Yard Slots in Oracle Database
                    </h5>
                    <small class="text-muted">Directly mapped to <code>yard_slots</code> table via PL/SQL procedures</small>
                </div>
                <div class="d-flex align-items-center gap-2">
                    <input type="text" id="slotTableSearch" class="form-control form-control-sm theme-select" placeholder="Filter slot name / type..." oninput="filterSlotTable(this.value)" style="width: 220px;">
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="slotsTable">
                    <thead>
                        <tr class="small text-muted" style="border-bottom: 2px solid var(--border-medium);">
                            <th>USEQ</th>
                            <th>SLOT NAME</th>
                            <th>TYPE</th>
                            <th>ROWS</th>
                            <th>TIERS (Y)</th>
                            <th>COLS (X)</th>
                            <th>CAPACITY</th>
                            <th>X START</th>
                            <th>Y START</th>
                            <th>STATUS</th>
                            <th class="text-end">ACTIONS</th>
                        </tr>
                    </thead>
                    <tbody id="slotsTableBody">
                        <!-- Populated by JavaScript and initial Razor model -->
                        @if (Model != null && Model.Count > 0)
                        {
                            @foreach (var s in Model)
                            {
                                <tr id="row-slot-@s.Useq">
                                    <td class="font-monospace fw-bold text-info">#@s.Useq</td>
                                    <td class="fw-bold" style="color: var(--text-highlight);">@s.YardSlotName</td>
                                    <td><span class="shipping-badge">@s.YardSlotType</span></td>
                                    <td class="font-monospace">@s.StackRows</td>
                                    <td class="font-monospace">@s.YAxis</td>
                                    <td class="font-monospace">@s.XAxis</td>
                                    <td class="font-monospace fw-bold text-warning">@(s.StackRows * s.YAxis * s.XAxis) TEU</td>
                                    <td class="small text-muted">@s.XAxisStartFrom</td>
                                    <td class="small text-muted">@s.YAxisStartFrom</td>
                                    <td>
                                        @if (s.Active == "Y")
                                        {
                                            <span class="unit-status-pill conn">ACTIVE</span>
                                        }
                                        else
                                        {
                                            <span class="unit-status-pill empty">INACTIVE</span>
                                        }
                                    </td>
                                    <td class="text-end">
                                        <button class="btn btn-sm btn-outline-warning me-1" onclick="editSlot(@s.Useq, '@s.YardSlotName', '@s.YardSlotType', @s.StackRows, @s.YAxis, @s.XAxis, '@s.XAxisStartFrom', '@s.YAxisStartFrom', '@s.Active', '@s.UserId')">
                                            <i class="bi bi-pencil-square"></i> Edit
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger" onclick="promptDeleteSlot(@s.Useq, '@s.YardSlotName')">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr id="emptySlotsRow">
                                <td colspan="11" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                                    No yard slots configured yet. Use the form above to insert your first yard slot.
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     CONFIRM DELETE MODAL
     ========================================================================= -->
<div class="modal fade" id="deleteConfirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content modal-custom">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-exclamation-triangle-fill text-danger fs-5"></i>
                    <h6 class="modal-title fw-bold mb-0" style="color: var(--text-highlight);">Confirm Delete Slot</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <p class="small mb-1" style="color: var(--text-primary);">
                    Are you sure you want to delete yard slot <strong class="text-warning" id="deleteSlotName"></strong> (USEQ: #<span id="deleteSlotUseq"></span>)?
                </p>
                <small class="text-muted">This will execute <code>Pkg_Front_End.Delete_yard_solt</code> in the Oracle database.</small>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-sm btn-danger px-3 fw-bold" onclick="executeDeleteSlot()">Confirm Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- =========================================================================
     OPERATIONS NOTIFICATION MODAL
     ========================================================================= -->
<div class="modal fade" id="slotNoticeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content modal-custom">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-info fs-5" id="slotNoticeIcon"></i>
                    <h6 class="modal-title fw-bold mb-0" style="color: var(--text-highlight);" id="slotNoticeTitle">Notice</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-3">
                <p class="small mb-0" style="color: var(--text-secondary);" id="slotNoticeMessage"></p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-info px-4" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        // =========================================================================
        // 1. THEME SUPPORT
        // =========================================================================
        function initTheme() {
            const savedTheme = localStorage.getItem('yard_theme') || 'dark';
            applyTheme(savedTheme);
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            applyTheme(newTheme);
            localStorage.setItem('yard_theme', newTheme);
        }

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            if (theme === 'light') {
                if (icon) icon.className = 'bi bi-sun-fill text-warning';
                if (label) label.innerText = 'Light Mode';
            } else {
                if (icon) icon.className = 'bi bi-moon-stars-fill text-info';
                if (label) label.innerText = 'Dark Mode';
            }
        }
        initTheme();

        // =========================================================================
        // 2. LIVE PREVIEW GENERATOR
        // =========================================================================
        function updatePreview() {
            const name = document.getElementById('slotName').value.trim() || 'NEW-SLOT';
            const type = document.getElementById('slotType').value;
            const rows = parseInt(document.getElementById('stackRows').value) || 14;
            const tiers = parseInt(document.getElementById('yAxis').value) || 6;
            const cols = parseInt(document.getElementById('xAxis').value) || 6;
            const xStart = document.getElementById('xAxisStart').value;
            const yStart = document.getElementById('yAxisStart').value;

            const totalCap = rows * tiers * cols;
            document.getElementById('capacityPill').innerText = `${totalCap} TEU (${rows} Rows × ${tiers} Tiers × ${cols} Cols)`;
            document.getElementById('previewBadge').innerText = `${name} • ${tiers}T × ${cols}C (${totalCap} TEU)`;

            // Generate column labels
            let colLabels = [];
            for (let c = 0; c < cols; c++) {
                if (xStart === '1') {
                    colLabels.push((c + 1).toString());
                } else {
                    colLabels.push(String.fromCharCode(65 + (c % 26)));
                }
            }

            let html = `
                <div class="block-head">
                    <div class="block-head-title">
                        <span class="badge-stack">${type}</span>
                        <span>${name}</span>
                    </div>
                    <span class="block-head-stats">${rows} Rows • ${tiers}x${cols}</span>
                </div>
                <div class="mini-grid" style="grid-template-columns: 22px repeat(${cols}, 1fr);">
                    <div class="l"></div>
                    ${colLabels.map(l => `<div class="l">${l}</div>`).join('')}`;

            for (let t = tiers; t >= 1; t--) {
                const tierLabel = (yStart === 'TOP') ? (tiers - t + 1) : t;
                html += `<div class="l">${tierLabel}</div>`;
                for (let c = 0; c < cols; c++) {
                    const sampleStatus = (t === 1 || (t <= 3 && c % 2 === 0)) ? 'conn' : 'empty';
                    html += `<div class="c ${sampleStatus}" style="height: 18px;" title="Tier ${tierLabel} Col ${colLabels[c]}"></div>`;
                }
            }

            html += `</div>`;
            document.getElementById('previewCard').innerHTML = html;
        }
        updatePreview();

        // =========================================================================
        // 3. FORM OPERATIONS (INSERT & UPDATE VIA ORACLE)
        // =========================================================================
        let isEditMode = false;

        function resetFormToNew() {
            isEditMode = false;
            document.getElementById('slotUseq').value = '0';
            document.getElementById('slotName').value = '';
            document.getElementById('slotType').value = 'STANDARD';
            document.getElementById('stackRows').value = '14';
            document.getElementById('yAxis').value = '6';
            document.getElementById('xAxis').value = '6';
            document.getElementById('xAxisStart').value = 'A';
            document.getElementById('yAxisStart').value = '1';
            document.getElementById('slotActive').value = 'Y';
            document.getElementById('slotUserId').value = 'ADMIN';

            document.getElementById('formHeaderTitle').innerHTML = '<i class="bi bi-plus-square me-2"></i>Insert New Yard Slot';
            document.getElementById('formModeBadge').innerText = 'MODE: INSERT';
            document.getElementById('formModeBadge').className = 'badge-custom text-warning';
            document.getElementById('btnSubmitSlot').innerHTML = '<i class="bi bi-check-circle me-1"></i> Save Yard Slot (Insert)';
            document.getElementById('btnSubmitSlot').className = 'btn btn-success flex-fill fw-bold';

            updatePreview();
        }

        function editSlot(useq, name, type, rows, yAxis, xAxis, xStart, yStart, active, userId) {
            isEditMode = true;
            document.getElementById('slotUseq').value = useq;
            document.getElementById('slotName').value = name;
            document.getElementById('slotType').value = type;
            document.getElementById('stackRows').value = rows;
            document.getElementById('yAxis').value = yAxis;
            document.getElementById('xAxis').value = xAxis;
            document.getElementById('xAxisStart').value = xStart;
            document.getElementById('yAxisStart').value = yStart;
            document.getElementById('slotActive').value = active;
            document.getElementById('slotUserId').value = userId || 'ADMIN';

            document.getElementById('formHeaderTitle').innerHTML = `<i class="bi bi-pencil-square me-2"></i>Update Yard Slot (#${useq})`;
            document.getElementById('formModeBadge').innerText = `MODE: UPDATE (#${useq})`;
            document.getElementById('formModeBadge').className = 'badge-custom text-info';
            document.getElementById('btnSubmitSlot').innerHTML = '<i class="bi bi-arrow-repeat me-1"></i> Update Yard Slot';
            document.getElementById('btnSubmitSlot').className = 'btn btn-info flex-fill fw-bold text-dark';

            window.scrollTo({ top: 0, behavior: 'smooth' });
            updatePreview();
        }

        async function handleSlotFormSubmit(e) {
            e.preventDefault();

            const useq = parseInt(document.getElementById('slotUseq').value) || 0;
            const slot = {
                useq: useq,
                yardSlotName: document.getElementById('slotName').value.trim(),
                yardSlotType: document.getElementById('slotType').value,
                stackRows: parseInt(document.getElementById('stackRows').value) || 14,
                yAxis: parseInt(document.getElementById('yAxis').value) || 6,
                xAxis: parseInt(document.getElementById('xAxis').value) || 6,
                xAxisStartFrom: document.getElementById('xAxisStart').value,
                yAxisStartFrom: document.getElementById('yAxisStart').value,
                active: document.getElementById('slotActive').value,
                userId: document.getElementById('slotUserId').value || 'ADMIN'
            };

            const endpoint = isEditMode ? '/api/yard/slots/update' : '/api/yard/slots/insert';

            try {
                const response = await fetch(endpoint, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify(slot)
                });

                const result = await response.json();

                if (response.ok && result.status === 'OK') {
                    showNotice(
                        isEditMode ? "Yard Slot Updated" : "Yard Slot Inserted",
                        `Yard Slot '${slot.yardSlotName}' (${slot.stackRows} Rows × ${slot.yAxis} Tiers × ${slot.xAxis} Cols) was successfully ${isEditMode ? "updated" : "saved"} in Oracle database.`,
                        "success"
                    );

                    resetFormToNew();
                    await reloadSlotsTable();
                } else {
                    showNotice("Operation Warning", result.message || "Failed to process slot.", "warning");
                }
            } catch (err) {
                showNotice("Network Error", "Unable to reach server. Please check connection: " + err.message, "danger");
            }
        }

        // =========================================================================
        // 4. DELETE SLOT (Pkg_Front_End.Delete_yard_solt)
        // =========================================================================
        let slotToDeleteUseq = 0;

        function promptDeleteSlot(useq, name) {
            slotToDeleteUseq = useq;
            document.getElementById('deleteSlotUseq').innerText = useq;
            document.getElementById('deleteSlotName').innerText = name;
            new bootstrap.Modal(document.getElementById('deleteConfirmModal')).show();
        }

        async function executeDeleteSlot() {
            if (!slotToDeleteUseq) return;

            const modalEl = document.getElementById('deleteConfirmModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            try {
                const response = await fetch('/api/yard/slots/delete', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ useq: slotToDeleteUseq, userId: "1" })
                });

                const result = await response.json();
                if (response.ok && result.status === 'OK') {
                    showNotice("Yard Slot Deleted", `Yard Slot #${slotToDeleteUseq} has been deleted via Pkg_Front_End.Delete_yard_solt.`, "success");
                    await reloadSlotsTable();
                } else {
                    showNotice("Delete Failed", result.message || "Could not delete slot.", "warning");
                }
            } catch (err) {
                showNotice("Error", err.message, "danger");
            }
        }

        // =========================================================================
        // 5. RELOAD & RENDER DATA TABLE
        // =========================================================================
        async function reloadSlotsTable() {
            try {
                const res = await fetch('/api/yard/slots');
                const json = await res.json();
                if (json.status === 'OK' && Array.isArray(json.data)) {
                    renderSlotsTable(json.data);
                }
            } catch (e) {
                console.error("Failed to reload slots table:", e);
            }
        }

        function renderSlotsTable(slots) {
            const tbody = document.getElementById('slotsTableBody');
            if (!slots || slots.length === 0) {
                tbody.innerHTML = `
                    <tr id="emptySlotsRow">
                        <td colspan="11" class="text-center py-4 text-muted">
                            <i class="bi bi-inbox fs-3 d-block mb-1"></i>
                            No yard slots found in database.
                        </td>
                    </tr>`;
                return;
            }

            tbody.innerHTML = slots.map(s => `
                <tr id="row-slot-${s.useq}">
                    <td class="font-monospace fw-bold text-info">#${s.useq}</td>
                    <td class="fw-bold" style="color: var(--text-highlight);">${s.yardSlotName}</td>
                    <td><span class="shipping-badge">${s.yardSlotType}</span></td>
                    <td class="font-monospace">${s.stackRows}</td>
                    <td class="font-monospace">${s.yAxis}</td>
                    <td class="font-monospace">${s.xAxis}</td>
                    <td class="font-monospace fw-bold text-warning">${s.stackRows * s.yAxis * s.xAxis} TEU</td>
                    <td class="small text-muted">${s.xAxisStartFrom}</td>
                    <td class="small text-muted">${s.yAxisStartFrom}</td>
                    <td>
                        <span class="unit-status-pill ${s.active === 'Y' ? 'conn' : 'empty'}">
                            ${s.active === 'Y' ? 'ACTIVE' : 'INACTIVE'}
                        </span>
                    </td>
                    <td class="text-end">
                        <button class="btn btn-sm btn-outline-warning me-1" onclick="editSlot(${s.useq}, '${s.yardSlotName}', '${s.yardSlotType}', ${s.stackRows}, ${s.yAxis}, ${s.xAxis}, '${s.xAxisStartFrom}', '${s.yAxisStartFrom}', '${s.active}', '${s.userId || 'ADMIN'}')">
                            <i class="bi bi-pencil-square"></i> Edit
                        </button>
                        <button class="btn btn-sm btn-outline-danger" onclick="promptDeleteSlot(${s.useq}, '${s.yardSlotName}')">
                            <i class="bi bi-trash"></i> Delete
                        </button>
                    </td>
                </tr>
            `).join('');
        }

        function filterSlotTable(query) {
            query = query.trim().toUpperCase();
            document.querySelectorAll('#slotsTableBody tr').forEach(row => {
                if (row.id === 'emptySlotsRow') return;
                const match = row.innerText.toUpperCase().includes(query);
                row.style.display = match ? '' : 'none';
            });
        }

        function showNotice(title, message, type = 'info') {
            document.getElementById('slotNoticeTitle').innerText = title;
            document.getElementById('slotNoticeMessage').innerText = message;
            const icon = document.getElementById('slotNoticeIcon');

            if (type === 'success') {
                icon.className = 'bi bi-check-circle-fill text-success fs-5';
            } else if (type === 'warning') {
                icon.className = 'bi bi-exclamation-triangle-fill text-warning fs-5';
            } else if (type === 'danger') {
                icon.className = 'bi bi-x-circle-fill text-danger fs-5';
            } else {
                icon.className = 'bi bi-info-circle-fill text-info fs-5';
            }

            new bootstrap.Modal(document.getElementById('slotNoticeModal')).show();
        }

        // =========================================================================
        // 6. SIGNALR REAL-TIME SYNC
        // =========================================================================
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/yardHub")
            .withAutomaticReconnect()
            .build();

        connection.on("YardSlotCreated", function (slot) {
            reloadSlotsTable();
        });

        connection.on("YardSlotUpdated", function (slot) {
            reloadSlotsTable();
        });

        connection.on("YardSlotDeleted", function (useq) {
            reloadSlotsTable();
        });

        connection.start().catch(err => console.log("SignalR Connection Error: ", err));
    </script>
}