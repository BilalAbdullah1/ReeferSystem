@{
    ViewData["Title"] = "Container Terminal Yard Operations";
}

<div class="app-wrapper">
    <!-- 1. Top Navigation Bar -->
    <header class="top-nav">
        <div class="brand-section">
            <div class="brand-logo-icon">
                <i class="bi bi-boxes"></i>
            </div>
            <div>
                <div class="brand-title">CONTAINER <span style="color: var(--color-cyan);">YARD</span> TOS</div>
                <div class="brand-tag">Terminal Operating System & Inventory Tracking</div>
            </div>
            <div class="brand-zone-badge">
                <i class="bi bi-geo-alt-fill me-1"></i>STACK: AB (14 ROWS)
            </div>
        </div>

        <div class="nav-controls">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="containerSearch" class="search-input" 
                       placeholder="Search Container No (e.g. GLDU5661160, ECMU, CMAU) or Line / Row..." 
                       oninput="handleSearch(this.value)">
            </div>
        </div>

        <div class="nav-actions">
            <div class="mq-indicator" id="brokerPill">
                <span class="status-dot pulsing" id="brokerDot"></span>
                <span id="brokerText">BROKER: CONNECTED</span>
            </div>
            <div class="clock-display" id="clock">00:00:00</div>
            <button class="btn btn-sm btn-outline-secondary" onclick="resetRowSequence()" title="Reset yard row order to default (01 to 14)">
                <i class="bi bi-arrow-clockwise me-1"></i>Reset Rows
            </button>
            <button class="theme-toggle-btn" id="themeToggleBtn" onclick="toggleTheme()" title="Switch theme">
                <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                <span id="themeLabel">Dark Mode</span>
            </button>
        </div>
    </header>

    <!-- 2. Main Workspace -->
    <div class="main-layout">
        <!-- Sidebar: Clean Container Information Panel (NO 3D) -->
        <aside class="sidebar" id="sidebarInspector">
            <div class="sidebar-header">
                <div class="sidebar-title">
                    <span><i class="bi bi-info-circle-fill me-1 text-info"></i> Container Details</span>
                    <span class="badge bg-secondary" id="sidebarRowBadge">ROW AB-01</span>
                </div>
            </div>

            <div class="sidebar-body">
                <!-- Selected Unit Identity Card -->
                <div class="inspector-card has-selection" id="inspectorCard">
                    <div class="inspector-header">
                        <div>
                            <div class="d-flex align-items-center gap-2 mb-1">
                                <span class="shipping-badge" id="sideLineBadge">CMA</span>
                                <span class="badge-custom" id="sideIsoBadge">22G1 (20ft DR)</span>
                            </div>
                            <h3 class="unit-id-title" id="sideContainerNo">GLDU5661160</h3>
                        </div>
                        <span class="unit-status-pill conn" id="sideStatusPill">DELIVERED</span>
                    </div>

                    <!-- Current Position in Yard -->
                    <div class="position-matrix-card mt-2">
                        <div class="position-matrix-title">
                            <i class="bi bi-geo-alt-fill text-info me-1"></i> Current Yard Slot
                        </div>
                        <div class="position-grid">
                            <div class="pos-item">
                                <div class="pos-item-label">STACK</div>
                                <div class="pos-item-value" id="sideStack">AB</div>
                            </div>
                            <div class="pos-item">
                                <div class="pos-item-label">ROW</div>
                                <div class="pos-item-value" id="sideRow">AB-01</div>
                            </div>
                            <div class="pos-item">
                                <div class="pos-item-label">TIER</div>
                                <div class="pos-item-value" id="sideTier">Tier 6</div>
                            </div>
                            <div class="pos-item">
                                <div class="pos-item-label">COLUMN</div>
                                <div class="pos-item-value" id="sideCol">Col A</div>
                            </div>
                        </div>
                        <div class="pos-breadcrumb">
                            <span id="sideBreadcrumb">STACK: AB &gt; ROW: 01 &gt; TIER: 6 &gt; COL: A</span>
                        </div>
                    </div>
                </div>

                <!-- Sir's Table Specifications (Clean Grid) -->
                <div class="telemetry-card">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small fw-bold text-uppercase">Manifest Data (From Table)</span>
                        <span class="badge bg-primary text-white" id="sideCategoryBadge">COMMUNITY</span>
                    </div>

                    <div class="spec-grid">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Tare Weight</div>
                            <div class="spec-cell-val" id="sideWeight">2,180 KG</div>
                        </div>
                        <div class="spec-cell">
                            <div class="spec-cell-label">Ticket / EIR No</div>
                            <div class="spec-cell-val" id="sideTicket">1782</div>
                        </div>
                        <div class="spec-cell">
                            <div class="spec-cell-label">Height / Size</div>
                            <div class="spec-cell-val" id="sideHeight">20ft • 8'6"</div>
                        </div>
                        <div class="spec-cell">
                            <div class="spec-cell-label">Vehicle / Sub-Loc</div>
                            <div class="spec-cell-val" id="sideVehicle">OUT</div>
                        </div>
                        <div class="spec-cell">
                            <div class="spec-cell-label">Gate-In Date</div>
                            <div class="spec-cell-val" id="sideGateIn" style="font-size: 0.75rem;">2026-06-01 15:52</div>
                        </div>
                        <div class="spec-cell">
                            <div class="spec-cell-label">Operator</div>
                            <div class="spec-cell-val" id="sideOperator">SHOAIB</div>
                        </div>
                    </div>

                    <div class="mt-2 p-2 rounded card-subbox" style="font-size: 0.75rem;">
                        <span class="text-muted">Condition / Remarks:</span>
                        <strong class="d-block" style="color: var(--text-highlight);" id="sideRemarks">NORMAL (INSPECTED)</strong>
                    </div>
                </div>

                <!-- Direct Actions -->
                <div class="d-flex flex-column gap-2">
                    <button class="btn btn-info w-100 fw-bold" onclick="openSelectedContainerModal()">
                        <i class="bi bi-window-stack me-1"></i> Open Full Info & Move Modal
                    </button>
                    <button class="btn btn-sm btn-outline-warning w-100" onclick="enableYardDragging()">
                        <i class="bi bi-hand-index-thumb me-1"></i> Drag Move Container on Yard
                    </button>
                </div>
            </div>
        </aside>

        <!-- Content Area: Yard Overview & Rows Grid -->
        <main class="content-area" id="contentArea">
            <!-- 3. Yard Summary KPI Grid -->
            <div class="summary-grid">
                <div class="summary-card accent-cyan">
                    <div class="summary-label">STACK AB CAPACITY</div>
                    <div class="summary-value" id="kpiCapacity">504</div>
                    <div class="summary-subtext">14 Rows × 36 Slots</div>
                </div>
                <div class="summary-card accent-success">
                    <div class="summary-label">OCCUPIED CONTAINERS</div>
                    <div class="summary-value text-success" id="kpiOccupied">00</div>
                    <div class="summary-subtext">Active In-Yard Units</div>
                </div>
                <div class="summary-card accent-cyan">
                    <div class="summary-label">AVAILABLE EMPTY SLOTS</div>
                    <div class="summary-value text-info" id="kpiEmpty">504</div>
                    <div class="summary-subtext">Vacant Stacking Space</div>
                </div>
                <div class="summary-card accent-warning">
                    <div class="summary-label">YARD UTILIZATION</div>
                    <div class="summary-value text-warning" id="kpiOccupancy">0.0%</div>
                    <div class="summary-subtext">Occupancy Ratio</div>
                </div>
                <div class="summary-card accent-danger">
                    <div class="summary-label">HOLD / SPECIAL</div>
                    <div class="summary-value text-danger" id="kpiSpecial">00</div>
                    <div class="summary-subtext">Customs & Remarks</div>
                </div>
            </div>

            <!-- 4. Filter Toolbar -->
            <div class="filter-toolbar">
                <div class="filter-pills">
                    <button class="filter-btn active" data-filter="all" onclick="setFilter('all', this)">
                        <i class="bi bi-grid-fill me-1"></i> All Containers (<span id="filterAllCount">504</span>)
                    </button>
                    <button class="filter-btn" data-filter="20" onclick="setFilter('20', this)">
                        <span class="badge bg-secondary me-1">20ft</span> 20ft Units
                    </button>
                    <button class="filter-btn" data-filter="40" onclick="setFilter('40', this)">
                        <span class="badge bg-primary me-1">40ft</span> 40ft Units
                    </button>
                    <button class="filter-btn" data-filter="yard" onclick="setFilter('yard', this)">
                        <span class="status-dot bg-warning me-1"></span> In-Yard (QFS)
                    </button>
                    <button class="filter-btn" data-filter="delivered" onclick="setFilter('delivered', this)">
                        <span class="status-dot bg-success me-1"></span> Delivered
                    </button>
                    <button class="filter-btn" data-filter="empty" onclick="setFilter('empty', this)">
                        <i class="bi bi-circle me-1"></i> Empty Slots
                    </button>
                </div>

                <!-- Row Quick Jumper Chips (1 to 14) -->
                <div class="row-nav-scroller" id="rowJumperBar">
                    <span class="text-muted small fw-bold me-1">ROW:</span>
                    <!-- Populated dynamically: AB-01 to AB-14 -->
                </div>
            </div>

            <!-- Hint Bar -->
            <div class="d-flex align-items-center justify-content-between px-2 text-muted" style="font-size: 0.74rem;">
                <div>
                    <i class="bi bi-info-circle text-info me-1"></i>
                    Click any container to <strong>open its Information Modal</strong>. Drag row headers to <strong>reorder rows</strong>. Once selected, move its position via the modal or drag it.
                </div>
                <span class="badge-custom text-info" id="dragStatusBadge">Drag & Drop Ready</span>
            </div>

            <!-- 5. 14 Rows of Stack AB Grid -->
            <div class="yard-viewport-container" id="yardViewport">
                <div id="yardGrid" class="yard-grid-wrapper">
                    <!-- Dynamically generated: 14 Rows x 36 slots -->
                </div>
            </div>
        </main>
    </div>
</div>

<!-- =========================================================================
     CONTAINER INFORMATION & POSITION MOVE MODAL (Opens on click)
     ========================================================================= -->
<div class="modal fade" id="containerInfoModal" tabindex="-1" aria-labelledby="containerInfoModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content modal-custom">
            <!-- Modal Header -->
            <div class="modal-header">
                <div class="d-flex align-items-center gap-3">
                    <div class="brand-logo-icon" style="width: 42px; height: 42px; font-size: 1.3rem;">
                        <i class="bi bi-box-seam"></i>
                    </div>
                    <div>
                        <div class="d-flex align-items-center gap-2">
                            <h4 class="modal-title fw-bold mb-0" style="color: var(--text-highlight);" id="modalContainerNo">GLDU5661160</h4>
                            <span class="shipping-badge fs-6" id="modalLineBadge">CMA</span>
                            <span class="unit-status-pill conn" id="modalStatusBadge">DELIVERED</span>
                        </div>
                        <small class="text-muted" id="modalLocationSubtitle">
                            Currently in Stack AB &bull; Row AB-01 &bull; Tier 6 &bull; Column A
                        </small>
                    </div>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <!-- Modal Body -->
            <div class="modal-body p-4">
                <!-- 1. Manifest Data from Table -->
                <h6 class="text-info text-uppercase fw-bold small mb-2">
                    <i class="bi bi-table me-1"></i> Container Specifications (From Manifest Table)
                </h6>
                <div class="row g-2 mb-4">
                    <div class="col-md-3 col-6">
                        <div class="spec-cell">
                            <div class="spec-cell-label">ISO Size / Type</div>
                            <div class="spec-cell-val" id="modalIsoCode">22G1 (20ft DR)</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Height</div>
                            <div class="spec-cell-val" id="modalHeight">8'6" Height</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Tare Weight</div>
                            <div class="spec-cell-val" id="modalTareWeight">2,180 KG</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Ticket / EIR ID</div>
                            <div class="spec-cell-val" id="modalTicketNo">1782</div>
                        </div>
                    </div>

                    <div class="col-md-3 col-6">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Category / Mode</div>
                            <div class="spec-cell-val" id="modalCategory">COMMUNITY</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Vehicle / Sub-Loc</div>
                            <div class="spec-cell-val" id="modalVehicle">OUT</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Gate-In Date</div>
                            <div class="spec-cell-val" id="modalGateIn" style="font-size: 0.78rem;">2026-06-01 15:52:03</div>
                        </div>
                    </div>
                    <div class="col-md-3 col-6">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Gate-Out Date</div>
                            <div class="spec-cell-val" id="modalGateOut" style="font-size: 0.78rem;">2026-06-01 17:06:07</div>
                        </div>
                    </div>

                    <div class="col-md-6 col-12">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Terminal Operator</div>
                            <div class="spec-cell-val text-info" id="modalOperator">SHOAIB</div>
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <div class="spec-cell">
                            <div class="spec-cell-label">Condition & Remarks</div>
                            <div class="spec-cell-val" id="modalRemarks">NORMAL (NO DAMAGE)</div>
                        </div>
                    </div>
                </div>

                <!-- 2. Position Move Section -->
                <div class="p-3 rounded card-subbox">
                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <h6 class="text-warning text-uppercase fw-bold small mb-0">
                            <i class="bi bi-arrows-move me-1"></i> Move / Change Yard Position
                        </h6>
                        <span class="badge bg-secondary" id="modalCurrentSlotBadge">Current: Row AB-01 &bull; Tier 6 &bull; Col A</span>
                    </div>
                    <p class="text-muted small mb-3">
                        Select new destination position below to relocate this container. If destination slot is occupied, positions will swap.
