            { sno: 1334, no: "ECMU8060560", prefix: "ECMU", line: "CMA", size: "45", type: "DH", height: "96", iso: "L5G1", tare: "4500 KG", cat: "YARD", status: "QFS", vehicle: "OPEN", ticket: "2825", gateIn: "2026-09-30 01:59:31", opIn: "SHAHZAIB", gateOut: "2026-09-30 02:08:07", opOut: "SHAHZAIB", remarks: "45FT HIGH CUBE" }
        ];

        // Container store mapped by slot key (e.g. "SLOT-AB01-6A")
        let containerStore = {};
        let selectedSlotKey = "SLOT-AB01-6A";
        let isDraggingEnabled = false;
        let draggedSlotKey = null;

        // Seed Yard with Containers from Sir's Table
        function seedYardFromSirTable() {
            let dataIndex = 0;
            for (let r = 1; r <= TOTAL_ROWS; r++) {
                const rowStr = r.toString().padStart(2, '0');
                for (let t = 1; t <= TIERS_COUNT; t++) {
                    for (let c = 0; c < COLS.length; c++) {
                        const colLetter = COLS[c];
                        const slotKey = `SLOT-${STACK_NAME}${rowStr}-${t}${colLetter}`;
                        
                        // Fill approximately 70% of slots with records from Sir's dataset
                        const shouldFill = (t <= 3) || (Math.random() > 0.35);

                        if (shouldFill) {
                            const template = SIR_DATASET[dataIndex % SIR_DATASET.length];
                            dataIndex++;

                            containerStore[slotKey] = {
                                slotKey: slotKey,
                                stack: STACK_NAME,
                                row: rowStr,
                                tier: t.toString(),
                                col: colLetter,
                                sno: template.sno,
                                no: template.no,
                                prefix: template.prefix,
                                line: template.line,
                                size: template.size,
                                type: template.type,
                                height: template.height,
                                iso: template.iso,
                                tare: template.tare,
                                cat: template.cat,
                                status: template.status,
                                vehicle: template.vehicle,
                                ticket: template.ticket,
                                gateIn: template.gateIn,
                                opIn: template.opIn,
                                gateOut: template.gateOut,
                                opOut: template.opOut,
                                remarks: template.remarks
                            };
                        }
                    }
                }
            }

            // Ensure first unit exists
            if (!containerStore["SLOT-AB01-6A"]) {
                const t0 = SIR_DATASET[0];
                containerStore["SLOT-AB01-6A"] = {
                    slotKey: "SLOT-AB01-6A",
                    stack: "AB",
                    row: "01",
                    tier: "6",
                    col: "A",
                    ...t0
                };
            }
        }
        seedYardFromSirTable();

        // =========================================================================
        // 3. BUILD YARD GRID (NO 3D, NO ZOOM)
        // =========================================================================
        function buildYard() {
            const gridContainer = document.getElementById('yardGrid');
            const jumperBar = document.getElementById('rowJumperBar');
            const modalRowSelect = document.getElementById('modalTargetRow');

            gridContainer.innerHTML = '';
            jumperBar.innerHTML = `<span class="row-chip active" onclick="jumpToRow('all', this)">ALL</span>`;
            if (modalRowSelect) modalRowSelect.innerHTML = '';

            rowSequence.forEach((rowStr, index) => {
                const rowId = `ROW-${STACK_NAME}-${rowStr}`;

                // Row jumper chips
                jumperBar.innerHTML += `<span class="row-chip" onclick="jumpToRow('${rowId}', this)">AB-${rowStr}</span>`;

                // Modal Row options
                if (modalRowSelect) {
                    modalRowSelect.innerHTML += `<option value="${rowStr}">Row AB-${rowStr}</option>`;
                }

                // Row Block Card
                const rowBlock = document.createElement('div');
                rowBlock.className = 'yard-block';
                rowBlock.id = rowId;
                rowBlock.setAttribute('data-row', rowStr);
                rowBlock.setAttribute('draggable', 'true');

                rowBlock.innerHTML = `
                    <div class="block-head">
                        <div class="block-head-title">
                            <span class="row-drag-handle" title="Drag to reorder row position in yard">
                                <i class="bi bi-grip-vertical"></i>
                            </span>
                            <span class="row-order-badge">#${index + 1}</span>
                            <span class="badge-stack">${STACK_NAME}</span>
                            <span>ROW ${STACK_NAME}-${rowStr}</span>
                        </div>
                        <div class="d-flex align-items-center gap-1">
                            <button class="row-action-btn" title="Move row left" onclick="moveRowPosition('${rowStr}', -1); event.stopPropagation();">
                                <i class="bi bi-chevron-left"></i>
                            </button>
                            <button class="row-action-btn" title="Move row right" onclick="moveRowPosition('${rowStr}', 1); event.stopPropagation();">
                                <i class="bi bi-chevron-right"></i>
                            </button>
                            <span class="block-head-stats ms-1" id="stats-${rowStr}">0 / 36</span>
                        </div>
                    </div>
                    <div class="mini-grid">
                        <div class="l"></div>
                        ${COLS.map(c => `<div class="l">${c}</div>`).join('')}
                        ${generateRowSlots(rowStr)}
                    </div>`;

                attachRowDragEvents(rowBlock);
                gridContainer.appendChild(rowBlock);
            });

            updateCounters();
            updateSidebarDetails(selectedSlotKey);
        }

        function generateRowSlots(rowStr) {
            let html = '';
            for (let t = TIERS_COUNT; t >= 1; t--) {
                html += `<div class="l">${t}</div>`;
                for (let c = 0; c < COLS.length; c++) {
                    const colLetter = COLS[c];
                    const slotKey = `SLOT-${STACK_NAME}${rowStr}-${t}${colLetter}`;
                    const unit = containerStore[slotKey];
                    const isOccupied = !!unit;
                    const statusClass = isOccupied ? getCellColorClass(unit) : 'empty';

                    const tooltipText = isOccupied ? 
                        `${unit.no} | ${unit.line} (${unit.size}ft) | ${unit.status} | Tier ${t} Col ${colLetter}` : 
                        `Row AB-${rowStr} • Tier ${t} • Col ${colLetter} (EMPTY SLOT)`;

                    html += `
                        <div class="c ${statusClass}" 
                             id="${slotKey}"
                             data-slot="${slotKey}"
                             data-row="${rowStr}"
                             data-tier="${t}"
                             data-col="${colLetter}"
                             data-tooltip="${tooltipText}"
                             draggable="${isOccupied ? 'true' : 'false'}"
                             onclick="handleSlotClick('${slotKey}')"
                             ondragstart="handleContainerDragStart(event, '${slotKey}')"
                             ondragover="handleContainerDragOver(event)"
                             ondragleave="handleContainerDragLeave(event)"
                             ondrop="handleContainerDrop(event, '${slotKey}')">
                        </div>`;
                }
            }
            return html;
        }

        function getCellColorClass(unit) {
            if (!unit) return 'empty';
            if (unit.cat === 'YARD' || unit.status === 'QFS') return 'c-alert'; // In-Yard active
            if (unit.remarks && unit.remarks.includes('DENTED')) return 'alarm'; // Damage/Alert
            if (unit.size === '40' || unit.size === '45') return 'cleared'; // 40ft/45ft
            return 'conn'; // 20ft Delivered
        }

        // =========================================================================
        // 4. ON CLICK: SELECT & OPEN MODAL INTERFACE (NO ZOOM)
        // =========================================================================
        let lastOccupiedKey = "SLOT-AB01-6A";

        function handleSlotClick(slotKey) {
            selectedSlotKey = slotKey;

            // Highlight chosen slot
            document.querySelectorAll('.c.highlight').forEach(c => c.classList.remove('highlight'));
            document.querySelectorAll('.yard-block.highlighted-row').forEach(b => b.classList.remove('highlighted-row'));

            const el = document.getElementById(slotKey);
            if (el) {
                el.classList.add('highlight');
                const rowCard = el.closest('.yard-block');
                if (rowCard) rowCard.classList.add('highlighted-row');
            }

            // Update sidebar info
            updateSidebarDetails(slotKey);

            // Open either Container Modal or Empty Slot Modal
            const unit = containerStore[slotKey];
            if (unit) {
                lastOccupiedKey = slotKey;
                openSelectedContainerModal();
            } else {
                openEmptySlotModal(slotKey);
            }
        }

        function updateSidebarDetails(slotKey) {
            const unit = containerStore[slotKey];
            const el = document.getElementById(slotKey);
            const rowStr = el ? el.getAttribute('data-row') : slotKey.substring(7, 9);
            const tierStr = el ? el.getAttribute('data-tier') : slotKey.substring(10, 11);
            const colStr = el ? el.getAttribute('data-col') : slotKey.substring(11, 12);

            document.getElementById('sideStack').innerText = STACK_NAME;
            document.getElementById('sideRow').innerText = `AB-${rowStr}`;
            document.getElementById('sideTier').innerText = `Tier ${tierStr}`;
            document.getElementById('sideCol').innerText = `Col ${colStr}`;
            document.getElementById('sideBreadcrumb').innerText = `STACK: AB > ROW: ${rowStr} > TIER: ${tierStr} > COL: ${colStr}`;
            document.getElementById('sidebarRowBadge').innerText = `ROW AB-${rowStr}`;

            if (unit) {
                document.getElementById('sideContainerNo').innerText = unit.no;
                document.getElementById('sideLineBadge').innerText = unit.line;
                document.getElementById('sideIsoBadge').innerText = `${unit.iso} (${unit.size}ft ${unit.type})`;
                document.getElementById('sideStatusPill').innerText = unit.status;
                document.getElementById('sideStatusPill').className = 'unit-status-pill ' + (unit.status === 'DELIVERED' ? 'conn' : 'alert');
                document.getElementById('sideCategoryBadge').innerText = unit.cat;
                document.getElementById('sideWeight').innerText = unit.tare;
                document.getElementById('sideTicket').innerText = unit.ticket;
                document.getElementById('sideHeight').innerText = `${unit.size}ft • ${unit.height === '96' ? "9'6\" HC" : "8'6\" Std"}`;
                document.getElementById('sideVehicle').innerText = unit.vehicle || 'OUT';
                document.getElementById('sideGateIn').innerText = unit.gateIn || '--';
                document.getElementById('sideOperator').innerText = unit.opIn || '--';
                document.getElementById('sideRemarks').innerText = unit.remarks || 'NORMAL';
            } else {
                document.getElementById('sideContainerNo').innerText = "EMPTY SLOT";
                document.getElementById('sideLineBadge').innerText = "VACANT";
                document.getElementById('sideIsoBadge').innerText = "AVAILABLE";
                document.getElementById('sideStatusPill').innerText = "VACANT";
                document.getElementById('sideStatusPill').className = "unit-status-pill empty";
                document.getElementById('sideCategoryBadge').innerText = "VACANT";
                document.getElementById('sideWeight').innerText = "-- KG";
                document.getElementById('sideTicket').innerText = "--";
                document.getElementById('sideHeight').innerText = "--";
                document.getElementById('sideVehicle').innerText = "--";
                document.getElementById('sideGateIn').innerText = "--";
                document.getElementById('sideOperator').innerText = "--";
                document.getElementById('sideRemarks').innerText = "SLOT READY FOR INBOUND MOVE";
            }
        }

        function openSelectedContainerModal() {
            const unit = containerStore[selectedSlotKey];
            const el = document.getElementById(selectedSlotKey);
            const rowStr = el ? el.getAttribute('data-row') : selectedSlotKey.substring(7, 9);
            const tierStr = el ? el.getAttribute('data-tier') : selectedSlotKey.substring(10, 11);
            const colStr = el ? el.getAttribute('data-col') : selectedSlotKey.substring(11, 12);

            if (!unit) {
                openEmptySlotModal(selectedSlotKey);
                return;
            }

            // Populate Modal from Sir's table fields
            document.getElementById('modalContainerNo').innerText = unit.no;
            document.getElementById('modalLineBadge').innerText = unit.line;
            document.getElementById('modalStatusBadge').innerText = unit.status;
            document.getElementById('modalStatusBadge').className = 'unit-status-pill ' + (unit.status === 'DELIVERED' ? 'conn' : 'alert');
            document.getElementById('modalLocationSubtitle').innerText = `Location: Stack AB • Row AB-${rowStr} • Tier ${tierStr} • Column ${colStr}`;

            document.getElementById('modalIsoCode').innerText = `${unit.iso} (${unit.size}ft ${unit.type})`;
            document.getElementById('modalHeight').innerText = `${unit.height === '96' ? "9'6\" High Cube" : "8'6\" Standard"}`;
            document.getElementById('modalTareWeight').innerText = unit.tare;
            document.getElementById('modalTicketNo').innerText = unit.ticket;
            document.getElementById('modalCategory').innerText = unit.cat;
            document.getElementById('modalVehicle').innerText = unit.vehicle || 'OUT';
            document.getElementById('modalGateIn').innerText = unit.gateIn || '--';
            document.getElementById('modalGateOut').innerText = unit.gateOut || '--';
            document.getElementById('modalOperator').innerText = `${unit.opIn} (In) / ${unit.opOut} (Out)`;
            document.getElementById('modalRemarks').innerText = unit.remarks || 'NORMAL';

            // Setup Move section inside Modal
            document.getElementById('modalCurrentSlotBadge').innerText = `Current: Row AB-${rowStr} • Tier ${tierStr} • Col ${colStr}`;
            document.getElementById('modalTargetRow').value = rowStr;
            document.getElementById('modalTargetTier').value = tierStr;
            document.getElementById('modalTargetCol').value = colStr;

            previewTargetSlot();

            const modal = new bootstrap.Modal(document.getElementById('containerInfoModal'));
            modal.show();
        }

        function openEmptySlotModal(slotKey) {
            const el = document.getElementById(slotKey);
            const rowStr = el ? el.getAttribute('data-row') : slotKey.substring(7, 9);
            const tierStr = el ? el.getAttribute('data-tier') : slotKey.substring(10, 11);
            const colStr = el ? el.getAttribute('data-col') : slotKey.substring(11, 12);

            document.getElementById('emptySlotModalTitle').innerText = `Empty Slot: Row AB-${rowStr}`;
            document.getElementById('emptySlotModalCoords').innerText = `Tier ${tierStr} • Column ${colStr} • Vacant Slot`;
            document.getElementById('emptySlotLocText').innerText = `Stack AB • Row AB-${rowStr} • Tier ${tierStr} • Col ${colStr}`;

            // Check if there is an active container candidate to move here
            const moveBox = document.getElementById('emptySlotMoveBox');
            const candidateUnit = containerStore[lastOccupiedKey];
            if (candidateUnit && lastOccupiedKey !== slotKey) {
                document.getElementById('emptySlotCandidateNo').innerText = candidateUnit.no;
                moveBox.style.display = 'block';
            } else {
                moveBox.style.display = 'none';
            }

            const modal = new bootstrap.Modal(document.getElementById('emptySlotModal'));
            modal.show();
        }

        function confirmMoveToEmptySlot() {
            const modalEl = document.getElementById('emptySlotModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            const candidateUnit = containerStore[lastOccupiedKey];
            if (candidateUnit && lastOccupiedKey !== selectedSlotKey) {
                executeSlotMove(lastOccupiedKey, selectedSlotKey);
                showAppNotice("Container Relocated", `Container ${candidateUnit.no} moved successfully to ${selectedSlotKey.replace('SLOT-AB', 'Row AB-')}.`, "success");
            }
        }

        // =========================================================================
        // 5. CHANGE POSITION / MOVE CONTAINER (VIA MODAL OR DRAG)
        // =========================================================================
        function previewTargetSlot() {
            const targetRow = document.getElementById('modalTargetRow').value;
            const targetTier = document.getElementById('modalTargetTier').value;
            const targetCol = document.getElementById('modalTargetCol').value;
            const targetKey = `SLOT-${STACK_NAME}${targetRow}-${targetTier}${targetCol}`;

            const statusText = document.getElementById('modalTargetStatusText');

            if (targetKey === selectedSlotKey) {
                statusText.className = 'text-muted';
                statusText.innerText = 'Same as current slot';
                return;
            }

            const targetUnit = containerStore[targetKey];
            if (targetUnit) {
                statusText.className = 'text-warning';
                statusText.innerText = `Occupied by ${targetUnit.no} (${targetUnit.line}). Will Swap.`;
            } else {
                statusText.className = 'text-success';
                statusText.innerText = 'EMPTY / AVAILABLE (Direct Move)';
            }
        }

        function moveContainerFromModal() {
            const targetRow = document.getElementById('modalTargetRow').value;
            const targetTier = document.getElementById('modalTargetTier').value;
            const targetCol = document.getElementById('modalTargetCol').value;
            const targetKey = `SLOT-${STACK_NAME}${targetRow}-${targetTier}${targetCol}`;

            if (targetKey === selectedSlotKey) {
                showAppNotice("Invalid Target Position", "Target position is identical to current position. Please select a different Row, Tier or Column.", "warning");
                return;
            }

            const movedUnit = containerStore[selectedSlotKey];

            // Execute move
            executeSlotMove(selectedSlotKey, targetKey);

            // Hide modal
            const modalEl = document.getElementById('containerInfoModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();

            showAppNotice("Container Relocated", `Container ${movedUnit?.no || ''} moved to Row AB-${targetRow}, Tier ${targetTier}, Col ${targetCol}.`, "success");
        }

        function executeSlotMove(sourceKey, targetKey) {
            const sourceUnit = containerStore[sourceKey];
            if (!sourceUnit) return;

            const targetUnit = containerStore[targetKey];

            // Parse target row, tier, col
            const targetEl = document.getElementById(targetKey);
            const targetRow = targetEl ? targetEl.getAttribute('data-row') : targetKey.substring(7, 9);
            const targetTier = targetEl ? targetEl.getAttribute('data-tier') : targetKey.substring(10, 11);
            const targetCol = targetEl ? targetEl.getAttribute('data-col') : targetKey.substring(11, 12);

            // Move source unit
            delete containerStore[sourceKey];
            sourceUnit.slotKey = targetKey;
            sourceUnit.row = targetRow;
            sourceUnit.tier = targetTier;
            sourceUnit.col = targetCol;
            containerStore[targetKey] = sourceUnit;

            // Swap if target was occupied
            if (targetUnit) {
                const sourceEl = document.getElementById(sourceKey);
                targetUnit.slotKey = sourceKey;
                targetUnit.row = sourceEl ? sourceEl.getAttribute('data-row') : sourceKey.substring(7, 9);
                targetUnit.tier = sourceEl ? sourceEl.getAttribute('data-tier') : sourceKey.substring(10, 11);
                targetUnit.col = sourceEl ? sourceEl.getAttribute('data-col') : sourceKey.substring(11, 12);
                containerStore[sourceKey] = targetUnit;
            }

            // Refresh DOM cells
            refreshSlotDOM(sourceKey);
            refreshSlotDOM(targetKey);

            // Select new position
            selectedSlotKey = targetKey;
            lastOccupiedKey = targetKey;
            updateSidebarDetails(targetKey);

            // Apply highlight
            document.querySelectorAll('.c.highlight').forEach(c => c.classList.remove('highlight'));
            const newEl = document.getElementById(targetKey);
            if (newEl) newEl.classList.add('highlight');

            updateCounters();

            // Broadcast via SignalR
            if (connection && connection.state === signalR.HubConnectionState.Connected) {
                connection.invoke("RelocateContainer", sourceUnit.no, sourceKey, targetKey).catch(err => console.log(err));
            }
        }

        function refreshSlotDOM(slotKey) {
            const el = document.getElementById(slotKey);
            if (!el) return;

            const unit = containerStore[slotKey];
            const isOccupied = !!unit;
            const colorClass = isOccupied ? getCellColorClass(unit) : 'empty';

            el.className = 'c ' + colorClass;
            el.setAttribute('draggable', isOccupied ? 'true' : 'false');

            const t = el.getAttribute('data-tier');
            const c = el.getAttribute('data-col');
            const row = el.getAttribute('data-row');
            const tooltipText = isOccupied ? 
                `${unit.no} | ${unit.line} (${unit.size}ft) | ${unit.status} | Tier ${t} Col ${c}` : 
                `Row AB-${row} • Tier ${t} • Col ${c} (EMPTY SLOT)`;
            el.setAttribute('data-tooltip', tooltipText);
        }

        // Enable Drag Move on Yard directly
        function enableYardDragging() {
            isDraggingEnabled = true;
            document.getElementById('dragStatusBadge').className = 'badge bg-warning text-dark';
            document.getElementById('dragStatusBadge').innerText = 'Drag Mode Active';
            const unit = containerStore[selectedSlotKey];
            showAppNotice("Drag Mode Active", `You can now DRAG container ${unit?.no || ''} and DROP it onto any other slot in the yard.`, "info");
        }

        function enableYardDraggingAndCloseModal() {
            const modalEl = document.getElementById('containerInfoModal');
            const modal = bootstrap.Modal.getInstance(modalEl);
            if (modal) modal.hide();
            enableYardDragging();
        }

        // Universal App Notice Modal (Replaces browser alert/prompt)
        function showAppNotice(title, message, type = 'info') {
            document.getElementById('noticeTitle').innerText = title;
            document.getElementById('noticeMessage').innerText = message;
            const icon = document.getElementById('noticeIcon');

            if (type === 'success') {
                icon.className = 'bi bi-check-circle-fill text-success fs-5';
            } else if (type === 'warning') {
                icon.className = 'bi bi-exclamation-triangle-fill text-warning fs-5';
            } else if (type === 'danger') {
                icon.className = 'bi bi-x-circle-fill text-danger fs-5';
            } else {
                icon.className = 'bi bi-info-circle-fill text-info fs-5';
            }

            const modal = new bootstrap.Modal(document.getElementById('appNoticeModal'));
            modal.show();
        }

        // Drag and Drop Container Handlers
        function handleContainerDragStart(e, slotKey) {
            draggedSlotKey = slotKey;
            e.dataTransfer.effectAllowed = 'move';
            e.dataTransfer.setData('text/plain', slotKey);
            const el = document.getElementById(slotKey);
            if (el) el.classList.add('is-dragging-container');
            e.stopPropagation();
        }

        function handleContainerDragOver(e) {
            if (!draggedSlotKey) return;
            e.preventDefault();
            e.dataTransfer.dropEffect = 'move';
            e.currentTarget.classList.add('drop-target-hover');
            e.stopPropagation();
        }

        function handleContainerDragLeave(e) {
            e.currentTarget.classList.remove('drop-target-hover');
            e.stopPropagation();
        }

        function handleContainerDrop(e, targetSlotKey) {
            e.preventDefault();
            e.stopPropagation();
            e.currentTarget.classList.remove('drop-target-hover');

            if (!draggedSlotKey || draggedSlotKey === targetSlotKey) {
                cleanupContainerDrag();
                return;
            }

            const src = draggedSlotKey;
            cleanupContainerDrag();
            executeSlotMove(src, targetSlotKey);
        }

        function cleanupContainerDrag() {
            if (draggedSlotKey) {
                const el = document.getElementById(draggedSlotKey);
                if (el) el.classList.remove('is-dragging-container');
            }
            document.querySelectorAll('.c').forEach(c => c.classList.remove('drop-target-hover', 'is-dragging-container'));
            draggedSlotKey = null;
            const badge = document.getElementById('dragStatusBadge');
            if (badge) {
                badge.className = 'badge-custom text-info';
                badge.innerText = 'Drag & Drop Ready';
            }
        }

        // =========================================================================
        // 6. ROW REORDERING (DRAG & DROP ROWS)
        // =========================================================================
        let draggedRowCard = null;
        function attachRowDragEvents(rowEl) {
            rowEl.addEventListener('dragstart', (e) => {
                if (draggedSlotKey) return;
                draggedRowCard = rowEl;
                rowEl.classList.add('is-dragging-row');
                e.dataTransfer.effectAllowed = 'move';
                e.dataTransfer.setData('text/plain', rowEl.getAttribute('data-row'));
            });

            rowEl.addEventListener('dragend', () => {
                if (rowEl) rowEl.classList.remove('is-dragging-row');
                document.querySelectorAll('.yard-block').forEach(b => b.classList.remove('row-drag-over'));
                draggedRowCard = null;
            });

            rowEl.addEventListener('dragover', (e) => {
                if (!draggedRowCard || draggedRowCard === rowEl) return;
                e.preventDefault();
                e.dataTransfer.dropEffect = 'move';
                rowEl.classList.add('row-drag-over');
            });

            rowEl.addEventListener('dragleave', () => {
                rowEl.classList.remove('row-drag-over');
            });

            rowEl.addEventListener('drop', (e) => {
                if (!draggedRowCard || draggedRowCard === rowEl) return;
                e.preventDefault();
                rowEl.classList.remove('row-drag-over');

                const fromRow = draggedRowCard.getAttribute('data-row');
                const toRow = rowEl.getAttribute('data-row');

                const fromIdx = rowSequence.indexOf(fromRow);
                const toIdx = rowSequence.indexOf(toRow);

                if (fromIdx !== -1 && toIdx !== -1) {
                    rowSequence.splice(fromIdx, 1);
                    rowSequence.splice(toIdx, 0, fromRow);
                    localStorage.setItem('yard_row_sequence', JSON.stringify(rowSequence));
                    buildYard();
                }
            });
        }

        function moveRowPosition(rowStr, direction) {
            const idx = rowSequence.indexOf(rowStr);
            if (idx === -1) return;
            const newIdx = idx + direction;
            if (newIdx < 0 || newIdx >= rowSequence.length) return;

            rowSequence.splice(idx, 1);
            rowSequence.splice(newIdx, 0, rowStr);
            localStorage.setItem('yard_row_sequence', JSON.stringify(rowSequence));
            buildYard();
        }

        function resetRowSequence() {
            localStorage.removeItem('yard_row_sequence');
            initRowSequence();
            buildYard();
        }

        // =========================================================================
        // 7. SEARCH, FILTERS & ROW NAVIGATION
        // =========================================================================
        function handleSearch(query) {
            query = query.trim().toUpperCase();
            if (!query) {
                document.querySelectorAll('.yard-block').forEach(b => b.style.display = '');
                document.querySelectorAll('.c').forEach(c => c.style.opacity = '1');
                return;
            }

            // Direct match on container no
            for (const key in containerStore) {
                const u = containerStore[key];
                if (u.no.includes(query)) {
                    handleSlotClick(key);
                    return;
                }
            }

            // Filter row blocks by matching text
            document.querySelectorAll('.yard-block').forEach(block => {
                const match = block.innerHTML.toUpperCase().includes(query);
                block.style.display = match ? '' : 'none';
            });
        }

        function jumpToRow(targetId, btn) {
            document.querySelectorAll('.row-chip').forEach(c => c.classList.remove('active'));
            if (btn) btn.classList.add('active');

            if (targetId === 'all') {
                document.querySelectorAll('.yard-block').forEach(b => b.style.display = '');
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            const target = document.getElementById(targetId);
            if (target) {
                document.querySelectorAll('.yard-block').forEach(b => b.style.display = '');
                target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                target.classList.add('highlighted-row');
                setTimeout(() => target.classList.remove('highlighted-row'), 1800);
            }
        }

        function setFilter(filterType, btn) {
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            document.querySelectorAll('.c').forEach(cell => {
                const slotKey = cell.getAttribute('data-slot');
                const u = containerStore[slotKey];

                if (filterType === 'all') {
                    cell.style.opacity = '1';
                } else if (filterType === 'empty') {
                    cell.style.opacity = cell.classList.contains('empty') ? '1' : '0.12';
                } else if (filterType === '20') {
                    cell.style.opacity = (u && u.size === '20') ? '1' : '0.12';
                } else if (filterType === '40') {
                    cell.style.opacity = (u && (u.size === '40' || u.size === '45')) ? '1' : '0.12';
                } else if (filterType === 'yard') {
                    cell.style.opacity = (u && (u.cat === 'YARD' || u.status === 'QFS')) ? '1' : '0.12';
                } else if (filterType === 'delivered') {
                    cell.style.opacity = (u && u.status === 'DELIVERED') ? '1' : '0.12';
                }
            });
        }

        function updateCounters() {
            const total = TOTAL_ROWS * 36;
            const occupied = Object.keys(containerStore).length;
            const empty = total - occupied;
            const pct = ((occupied / total) * 100).toFixed(1);

            let special = 0;
            for (const k in containerStore) {
                const u = containerStore[k];
                if ((u.remarks && u.remarks.includes('DENTED')) || u.cat === 'YARD') special++;
            }

            document.getElementById('kpiCapacity').innerText = total;
            document.getElementById('kpiOccupied').innerText = occupied.toString().padStart(2, '0');
            document.getElementById('kpiEmpty').innerText = empty.toString().padStart(2, '0');
            document.getElementById('kpiOccupancy').innerText = `${pct}%`;
            document.getElementById('kpiSpecial').innerText = special.toString().padStart(2, '0');
            document.getElementById('filterAllCount').innerText = total;

            for (let r = 1; r <= TOTAL_ROWS; r++) {
                const rowStr = r.toString().padStart(2, '0');
                const rowEl = document.getElementById(`ROW-${STACK_NAME}-${rowStr}`);
                if (rowEl) {
                    const loaded = rowEl.querySelectorAll('.c:not(.empty)').length;
                    const s = document.getElementById(`stats-${rowStr}`);
                    if (s) s.innerText = `${loaded} / 36`;
                }
            }
        }

        // =========================================================================
        // 8. SIGNALR REAL-TIME SYNC
        // =========================================================================
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/yardHub")
            .withAutomaticReconnect()
            .build();

        connection.on("ContainerRelocated", function (containerId, fromSlot, toSlot) {
            executeSlotMove(fromSlot, toSlot);
        });

        connection.start()
            .then(() => {
                document.getElementById('brokerDot').className = 'status-dot pulsing';
                document.getElementById('brokerText').innerText = 'BROKER: CONNECTED';
            })
            .catch(() => {
                document.getElementById('brokerDot').className = 'status-dot bg-warning';
                document.getElementById('brokerText').innerText = 'BROKER: RETRYING...';
            });

        setInterval(() => {
            document.getElementById('clock').innerText = new Date().toLocaleTimeString();
        }, 1000);

        // Initial Build
        buildYard();
    </script>
}