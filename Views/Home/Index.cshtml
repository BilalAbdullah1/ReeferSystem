<!-- =========================================================================
     APP NOTIFICATION MODAL (Replaces all browser alert / promise popups)
     ========================================================================= -->
<div class="modal fade" id="appNoticeModal" tabindex="-1" aria-labelledby="appNoticeModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" style="max-width: 420px;">
        <div class="modal-content modal-custom">
            <div class="modal-header border-0 pb-0">
                <div class="d-flex align-items-center gap-2">
                    <i class="bi bi-info-circle-fill text-info fs-5" id="noticeIcon"></i>
                    <h6 class="modal-title fw-bold mb-0" style="color: var(--text-highlight);" id="noticeTitle">Yard Operations Notice</h6>
                </div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body py-3">
                <p class="small mb-0" style="color: var(--text-secondary);" id="noticeMessage">Action completed successfully.</p>
            </div>
            <div class="modal-footer border-0 pt-0">
                <button type="button" class="btn btn-sm btn-info px-4 fw-bold" data-bs-dismiss="modal">OK</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        // =========================================================================
        // 1. THEME MANAGEMENT
        // =========================================================================
        function initTheme() {
            const savedTheme = localStorage.getItem('yard_theme') || 'dark';
            applyTheme(savedTheme);
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            applyTheme(newTheme);
            localStorage.setItem('yard_theme', newTheme);
        }

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            if (theme === 'light') {
                icon.className = 'bi bi-sun-fill text-warning';
                label.innerText = 'Light Mode';
            } else {
                icon.className = 'bi bi-moon-stars-fill text-info';
                label.innerText = 'Dark Mode';
            }
        }
        initTheme();

        // =========================================================================
        // 2. YARD CONSTANTS & SIR'S REAL CONTAINER TABLE DATA
        // =========================================================================
        const STACK_NAME = "AB";
        const TOTAL_ROWS = 14;
        const TIERS_COUNT = 6;
        const COLS = ['A', 'B', 'C', 'D', 'E', 'F'];

        // Row sequence order (saved in localStorage for reordering)
        let rowSequence = [];
        function initRowSequence() {
            const saved = localStorage.getItem('yard_row_sequence');
            if (saved) {
                try {
                    rowSequence = JSON.parse(saved);
                    if (Array.isArray(rowSequence) && rowSequence.length === TOTAL_ROWS) return;
                } catch(e) {}
            }
            rowSequence = [];
            for (let r = 1; r <= TOTAL_ROWS; r++) {
                rowSequence.push(r.toString().padStart(2, '0'));
            }
        }
        initRowSequence();

        // Table Data from Sir's CSV dataset
        const SIR_DATASET = [
