@{
    ViewData["Title"] = "Yard Dashboard - Stack AB";
}

<div class="app-wrapper">
    <!-- 1. Top Navigation Bar -->
    <header class="top-nav">
        <div class="brand-section">
            <div class="brand-logo-icon">
                <i class="bi bi-boxes"></i>
            </div>
            <div>
                <div class="brand-title">REEFER <span style="color: var(--color-cyan);">CORE</span> TOS</div>
                <div class="brand-tag">Terminal Operations & Telemetry</div>
            </div>
            <div class="brand-zone-badge">
                <i class="bi bi-geo-alt-fill me-1"></i>STACK: AB (14 ROWS)
            </div>
        </div>

        <div class="nav-controls">
            <div class="search-box">
                <i class="bi bi-search"></i>
                <input type="text" id="containerSearch" class="search-input" placeholder="Search container (e.g. CONT-AB04-5C or AB-02)..." oninput="handleSearch(this.value)">
            </div>
        </div>

        <div class="nav-actions">
            <div class="mq-indicator" id="brokerPill">
                <span class="status-dot pulsing" id="brokerDot"></span>
                <span id="brokerText">BROKER: CONNECTED</span>
            </div>
            <div class="clock-display" id="clock">00:00:00</div>
            <button class="theme-toggle-btn" id="themeToggleBtn" onclick="toggleTheme()" title="Switch between Black and White themes">
                <i class="bi bi-moon-stars-fill" id="themeIcon"></i>
                <span id="themeLabel">Dark Mode</span>
            </button>
        </div>
    </header>

    <!-- 2. Main Workspace -->
    <div class="main-layout">
        <!-- Sidebar: Container Inspector & Position Watcher -->
        <aside class="sidebar" id="sidebarInspector">
            <div class="sidebar-header">
                <div class="sidebar-title">
                    <span><i class="bi bi-crosshair2 me-1"></i> Unit Inspector</span>
                    <span class="badge bg-secondary" id="inspectorBadge">STANDBY</span>
                </div>
            </div>

            <div class="sidebar-body">
                <!-- Selected Unit Identity Card -->
                <div class="inspector-card has-selection" id="inspectorCard">
                    <div class="inspector-header">
                        <div>
                            <small class="text-muted d-block" style="font-size: 0.68rem; font-weight: 700;">SELECTED UNIT ID</small>
                            <h3 class="unit-id-title" id="inspectorId">CONT-AB01-6A</h3>
                        </div>
                        <span class="unit-status-pill conn" id="inspectorStatusPill">CONNECTED</span>
                    </div>

                    <!-- Position Matrix Breakdown (Stack, Row, Tier, Col) -->
                    <div class="position-matrix-card">
                        <div class="position-matrix-title">
                            <i class="bi bi-grid-3x3-gap-fill me-1"></i> Physical Position Matrix
                        </div>
                        <div class="position-grid">
                            <div class="pos-item">
                                <div class="pos-item-label">STACK</div>
                                <div class="pos-item-value" id="posStack">AB</div>
                            </div>
                            <div class="pos-item">
                                <div class="pos-item-label">ROW / BAY</div>
                                <div class="pos-item-value" id="posRow">AB-01</div>
                            </div>
                            <div class="pos-item">
                                <div class="pos-item-label">TIER (HEIGHT)</div>
                                <div class="pos-item-value" id="posTier">Tier 6 (Top)</div>
                            </div>
                            <div class="pos-item">
                                <div class="pos-item-label">COLUMN</div>
                                <div class="pos-item-value" id="posCol">Column A</div>
                            </div>
                        </div>

                        <div class="pos-breadcrumb">
                            <i class="bi bi-diagram-3 text-info"></i>
                            <span id="posBreadcrumb">STACK: AB &gt; ROW: 01 &gt; TIER: 6 &gt; COL: A</span>
                        </div>
                    </div>
                </div>

                <!-- Interactive Mini Cross-Section Locator Visualizer -->
                <div class="visualizer-section">
                    <div class="visualizer-title">
                        <span><i class="bi bi-eye-fill me-1"></i> Row Cross-Section View</span>
                        <span class="badge" style="background: var(--bg-surface); border: 1px solid var(--border-medium); color: var(--color-cyan);" id="visRowBadge">ROW AB-01</span>
                    </div>
                    <div class="visualizer-grid-box">
                        <div class="visualizer-grid" id="miniCrossSection">
                            <!-- Populated dynamically to show where the container sits in the 6x6 row -->
                        </div>
                    </div>
                </div>

                <!-- Telemetry & Sensor Card -->
                <div class="telemetry-card">
                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted" style="font-size: 0.72rem; font-weight: 700; text-transform: uppercase;">Cargo Temperature</span>
                        <span class="badge bg-info text-dark" style="font-size: 0.65rem;" id="setpointBadge">Target: -20.0°C</span>
                    </div>
                    <div class="temp-large-box">
                        <div class="temp-value-large" id="inspectorTemp">-21.5</div>
                        <div class="temp-unit">°C</div>
                    </div>

                    <div class="telemetry-row">
                        <span>Supply Air</span>
                        <span id="telSupplyAir">-22.8°C</span>
                    </div>
                    <div class="telemetry-row">
                        <span>Return Air</span>
                        <span id="telReturnAir">-21.5°C</span>
                    </div>
                    <div class="telemetry-row">
                        <span>Power Supply</span>
                        <span id="telPower"><i class="bi bi-lightning-charge-fill text-warning me-1"></i>440V 60Hz 3-Phase</span>
                    </div>
                    <div class="telemetry-row">
                        <span>Compressor Duty</span>
                        <span id="telCompressor">85% Normal</span>
                    </div>
                    <div class="telemetry-row">
                        <span>Last Telemetry</span>
                        <span id="telLastSeen">Just now</span>
                    </div>
                </div>

                <!-- Interactive Action Buttons -->
                <div class="d-flex gap-2">
                    <button class="btn btn-sm btn-outline-info flex-fill" onclick="simulatePing()" style="font-size: 0.78rem;">
                        <i class="bi bi-broadcast me-1"></i> Send Ping
                    </button>
                    <button class="btn btn-sm btn-outline-secondary flex-fill" onclick="resetSelection()" style="font-size: 0.78rem;">
                        <i class="bi bi-arrow-counterclockwise me-1"></i> Clear Select
                    </button>
                </div>
            </div>
        </aside>

        <!-- Content Area: Yard Summary & Stack AB Rows Grid -->
        <main class="content-area">
            <!-- 3. Yard Summary KPI Grid -->
            <div class="summary-grid">
                <div class="summary-card accent-cyan">
                    <div class="summary-label">STACK AB CAPACITY</div>
                    <div class="summary-value" id="kpiCapacity">504</div>
                    <div class="summary-subtext">14 Rows × 36 Containers</div>
                </div>
                <div class="summary-card accent-success">
                    <div class="summary-label">ONLINE / STABLE</div>
                    <div class="summary-value text-success" id="kpiOnline">00</div>
                    <div class="summary-subtext">Operating within setpoint</div>
                </div>
                <div class="summary-card accent-danger">
                    <div class="summary-label">ACTIVE ALARMS</div>
                    <div class="summary-value text-danger" id="kpiAlarms">00</div>
                    <div class="summary-subtext">Requires immediate check</div>
                </div>
                <div class="summary-card accent-warning">
                    <div class="summary-label">WARNING ALERTS</div>
                    <div class="summary-value text-warning" id="kpiAlerts">00</div>
                    <div class="summary-subtext">Defrost / Temp drift</div>
                </div>
                <div class="summary-card accent-cyan">
                    <div class="summary-label">POWER REEFER LOAD</div>
                    <div class="summary-value" id="kpiLoad">0.0 MW</div>
                    <div class="summary-subtext">Live substation load</div>
                </div>
            </div>

            <!-- 4. Quick Row Jump & Filter Toolbar -->
            <div class="filter-toolbar">
                <div class="filter-pills">
                    <button class="filter-btn active" data-filter="all" onclick="setFilter('all', this)">
                        <i class="bi bi-grid-fill me-1"></i> All Units (504)
                    </button>
                    <button class="filter-btn" data-filter="conn" onclick="setFilter('conn', this)">
                        <span class="status-dot bg-success me-1"></span> Stable
                    </button>
                    <button class="filter-btn" data-filter="alarm" onclick="setFilter('alarm', this)">
                        <span class="status-dot bg-danger me-1"></span> Alarms
                    </button>
                    <button class="filter-btn" data-filter="c-alert" onclick="setFilter('c-alert', this)">
                        <span class="status-dot bg-warning me-1"></span> Alerts
                    </button>
                    <button class="filter-btn" data-filter="empty" onclick="setFilter('empty', this)">
                        <i class="bi bi-circle me-1"></i> Empty Slots
                    </button>
                </div>

                <!-- Row Quick Jumper Chips (1 to 14) -->
                <div class="row-nav-scroller" id="rowJumperBar">
                    <span class="text-muted small fw-bold me-1">JUMP TO ROW:</span>
                    <!-- Generated dynamically: All, AB-01 to AB-14 -->
                </div>
            </div>

            <!-- 5. 14 Rows of Stack AB Grid -->
            <div id="yardGrid" class="yard-grid-wrapper">
                <!-- Dynamically generated via JavaScript: 14 Rows each with 6 Tiers x 6 Columns = 36 containers -->
            </div>
        </main>
    </div>
</div>

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.0/signalr.min.js"></script>

    <script>
        // =========================================================================
        // 1. THEME SYSTEM (Dark / Light Theme Persistence)
        // =========================================================================
        function initTheme() {
            const savedTheme = localStorage.getItem('reefer_theme') || 'dark';
            applyTheme(savedTheme);
        }

        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
            const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
            applyTheme(newTheme);
            localStorage.setItem('reefer_theme', newTheme);
        }

        function applyTheme(theme) {
            document.documentElement.setAttribute('data-theme', theme);
            const icon = document.getElementById('themeIcon');
            const label = document.getElementById('themeLabel');
            if (theme === 'light') {
                icon.className = 'bi bi-sun-fill text-warning';
                label.innerText = 'Light Mode';
            } else {
                icon.className = 'bi bi-moon-stars-fill text-info';
                label.innerText = 'Dark Mode';
            }
        }

        initTheme();

        // =========================================================================
        // 2. YARD CONFIGURATION (Stack AB: 14 Rows, 6 Tiers, 6 Columns)
        // =========================================================================
        const STACK_NAME = "AB";
        const TOTAL_ROWS = 14;
        const TIERS_COUNT = 6;
        const COLS = ['A', 'B', 'C', 'D', 'E', 'F'];

        let selectedUnit = {
            id: 'CONT-AB01-6A',
            stack: 'AB',
            row: '01',
            tier: '6',
            col: 'A',
            temp: '-21.5',
            status: 'EMPTY'
        };

        let activeFilter = 'all';

        // =========================================================================
        // 3. GENERATE YARD GRID (14 Rows x 36 Containers = 504 Containers)
        // =========================================================================
        function buildYard() {
            const gridContainer = document.getElementById('yardGrid');
            const jumperBar = document.getElementById('rowJumperBar');
            gridContainer.innerHTML = '';

            // Row jumper button for 'ALL'
            jumperBar.innerHTML = `<span class="text-muted small fw-bold me-1">JUMP TO:</span>
                <span class="row-chip active" onclick="jumpToRow('all', this)">ALL</span>`;

            for (let r = 1; r <= TOTAL_ROWS; r++) {
                const rowStr = r.toString().padStart(2, '0');
                const rowId = `ROW-${STACK_NAME}-${rowStr}`;

                // Add to Jumper bar
                jumperBar.innerHTML += `<span class="row-chip" onclick="jumpToRow('${rowId}', this)">AB-${rowStr}</span>`;

                // Build Row Block Card
                gridContainer.innerHTML += `
                    <div class="yard-block" id="${rowId}" data-row="${rowStr}">
                        <div class="block-head">
                            <div class="block-head-title">
                                <span class="badge-stack">${STACK_NAME}</span>
                                <span>ROW ${STACK_NAME}-${rowStr}</span>
                            </div>
                            <div class="block-head-stats">
                                <span id="stats-${rowStr}">0 / 36 units</span>
                            </div>
                        </div>
                        <div class="mini-grid">
                            <div class="l"></div>
                            ${COLS.map(c => `<div class="l">${c}</div>`).join('')}
                            ${generateRowCells(rowStr)}
                        </div>
                    </div>`;
            }

            // Render mini visualizer for default selection
            renderMiniCrossSection(selectedUnit.row, selectedUnit.tier, selectedUnit.col);
        }

        function generateRowCells(rowStr) {
            let html = '';
            // Tiers from 6 down to 1 (Tier 6 top, Tier 1 ground level)
            for (let t = TIERS_COUNT; t >= 1; t--) {
                html += `<div class="l">${t}</div>`;
                for (let c = 0; c < COLS.length; c++) {
                    const colLetter = COLS[c];
                    const contId = `CONT-${STACK_NAME}${rowStr}-${t}${colLetter}`;
                    html += `
                        <div class="c empty" 
                             id="${contId}"
                             data-id="${contId}" 
                             data-stack="${STACK_NAME}" 
                             data-row="${rowStr}" 
                             data-tier="${t}" 
                             data-col="${colLetter}"
                             data-temp="--.-"
                             data-status="EMPTY"
                             data-tooltip="${contId} | Tier ${t} Col ${colLetter}"
                             onclick="handleContainerClick('${contId}')">
                        </div>`;
                }
            }
            return html;
        }

        // =========================================================================
        // 4. CONTAINER SELECTION & INSPECTOR DETAILS (The User's Core Requirement)
        // =========================================================================
        function handleContainerClick(containerId) {
            const el = document.getElementById(containerId);
            if (!el) return;

            // Remove existing highlight
            document.querySelectorAll('.c.highlight').forEach(c => c.classList.remove('highlight'));
            document.querySelectorAll('.yard-block.highlighted-row').forEach(b => b.classList.remove('highlighted-row'));

            // Apply highlight to chosen cell & parent row
            el.classList.add('highlight');
            const parentRow = el.closest('.yard-block');
            if (parentRow) parentRow.classList.add('highlighted-row');

            // Extract metadata
            const stack = el.getAttribute('data-stack');
            const row = el.getAttribute('data-row');
            const tier = el.getAttribute('data-tier');
            const col = el.getAttribute('data-col');
            const temp = el.getAttribute('data-temp') || '--.-';
            const status = el.getAttribute('data-status') || 'EMPTY';

            selectedUnit = { id: containerId, stack, row, tier, col, temp, status };

            // Update UI Inspector Sidebar
            updateInspectorUI();
        }

        function updateInspectorUI() {
            document.getElementById('inspectorId').innerText = selectedUnit.id;
            document.getElementById('posStack').innerText = selectedUnit.stack;
            document.getElementById('posRow').innerText = `${selectedUnit.stack}-${selectedUnit.row}`;
            document.getElementById('posTier').innerText = `Tier ${selectedUnit.tier} ${selectedUnit.tier == 6 ? '(Top)' : (selectedUnit.tier == 1 ? '(Base)' : '')}`;
            document.getElementById('posCol').innerText = `Column ${selectedUnit.col}`;
            document.getElementById('posBreadcrumb').innerText = 
                `STACK: ${selectedUnit.stack} > ROW: ${selectedUnit.row} > TIER: ${selectedUnit.tier} > COL: ${selectedUnit.col}`;

            // Status Pill
            const pill = document.getElementById('inspectorStatusPill');
            const rawStatus = (selectedUnit.status || 'EMPTY').toUpperCase();
            pill.innerText = rawStatus;
            pill.className = 'unit-status-pill ' + (rawStatus === 'CONN' ? 'conn' : (rawStatus === 'ALARM' ? 'alarm' : (rawStatus === 'ALERT' ? 'alert' : 'empty')));

            // Temperature
            const tempBox = document.getElementById('inspectorTemp');
            tempBox.innerText = selectedUnit.temp !== '--.-' ? selectedUnit.temp : '--.-';

            if (rawStatus === 'ALARM') {
                tempBox.style.color = 'var(--color-danger)';
            } else if (rawStatus === 'ALERT') {
                tempBox.style.color = 'var(--color-warning)';
            } else {
                tempBox.style.color = 'var(--color-cyan)';
            }

            // Sub-telemetries
            if (selectedUnit.temp !== '--.-') {
                const numericTemp = parseFloat(selectedUnit.temp);
                document.getElementById('telSupplyAir').innerText = (numericTemp - 1.3).toFixed(1) + '°C';
                document.getElementById('telReturnAir').innerText = selectedUnit.temp + '°C';
                document.getElementById('telCompressor').innerText = rawStatus === 'ALARM' ? 'Defrost / Fault Cycle' : 'Running (84% Load)';
                document.getElementById('telLastSeen').innerText = 'Live Signal';
            } else {
                document.getElementById('telSupplyAir').innerText = '--.-°C';
                document.getElementById('telReturnAir').innerText = '--.-°C';
                document.getElementById('telCompressor').innerText = 'Standby';
                document.getElementById('telLastSeen').innerText = 'Slot Vacant';
            }

            document.getElementById('inspectorBadge').innerText = `${selectedUnit.stack}-${selectedUnit.row}`;

            // Update mini visualizer for this row
            renderMiniCrossSection(selectedUnit.row, selectedUnit.tier, selectedUnit.col);
        }

        // Mini 6x6 Cross-Section Visualizer in the Sidebar
        function renderMiniCrossSection(activeRow, activeTier, activeCol) {
            document.getElementById('visRowBadge').innerText = `ROW ${STACK_NAME}-${activeRow}`;
            const visGrid = document.getElementById('miniCrossSection');
            let html = `<div class="vis-l"></div>`;
            COLS.forEach(c => { html += `<div class="vis-l">${c}</div>`; });

            for (let t = TIERS_COUNT; t >= 1; t--) {
                html += `<div class="vis-l">${t}</div>`;
                for (let c = 0; c < COLS.length; c++) {
                    const colLetter = COLS[c];
                    const isTarget = (t.toString() === activeTier.toString() && colLetter === activeCol);
                    html += `<div class="vis-cell ${isTarget ? 'active-target' : ''}" title="Tier ${t} Col ${colLetter}"></div>`;
                }
            }
            visGrid.innerHTML = html;
        }

        function resetSelection() {
            document.querySelectorAll('.c.highlight').forEach(c => c.classList.remove('highlight'));
            document.querySelectorAll('.yard-block.highlighted-row').forEach(b => b.classList.remove('highlighted-row'));
            handleContainerClick('CONT-AB01-6A');
        }

        function simulatePing() {
            if (!selectedUnit.id) return;
            const el = document.getElementById(selectedUnit.id);
            if (el) {
                el.classList.add('highlight');
                const prevColor = el.style.boxShadow;
                el.style.boxShadow = '0 0 30px #ffffff';
                setTimeout(() => { el.style.boxShadow = prevColor; }, 800);
            }
        }

        // =========================================================================
        // 5. SEARCH & ROW JUMPING
        // =========================================================================
        function handleSearch(query) {
            query = query.trim().toUpperCase();
            if (!query) {
                document.querySelectorAll('.yard-block').forEach(b => b.style.display = '');
                return;
            }

            // Direct container hit
            const directTarget = document.getElementById(query);
            if (directTarget) {
                handleContainerClick(query);
                directTarget.scrollIntoView({ behavior: 'smooth', block: 'center' });
                return;
            }

            // Filter row cards
            document.querySelectorAll('.yard-block').forEach(block => {
                const rowStr = block.getAttribute('data-row');
                const rowMatch = `AB-${rowStr}`.includes(query) || `AB${rowStr}`.includes(query) || rowStr === query;
                const innerMatch = block.innerHTML.toUpperCase().includes(query);
                block.style.display = (rowMatch || innerMatch) ? '' : 'none';
            });
        }

        function jumpToRow(targetId, btn) {
            document.querySelectorAll('.row-chip').forEach(c => c.classList.remove('active'));
            if (btn) btn.classList.add('active');

            if (targetId === 'all') {
                document.querySelectorAll('.yard-block').forEach(b => b.style.display = '');
                window.scrollTo({ top: 0, behavior: 'smooth' });
                return;
            }

            const target = document.getElementById(targetId);
            if (target) {
                document.querySelectorAll('.yard-block').forEach(b => b.style.display = '');
                target.scrollIntoView({ behavior: 'smooth', block: 'center' });
                target.classList.add('highlighted-row');
                setTimeout(() => target.classList.remove('highlighted-row'), 2000);
            }
        }

        // =========================================================================
        // 6. FILTERING (All, Stable, Alarms, Alerts, Empty)
        // =========================================================================
        function setFilter(filterType, btn) {
            activeFilter = filterType;
            document.querySelectorAll('.filter-btn').forEach(b => b.classList.remove('active'));
            if (btn) btn.classList.add('active');

            document.querySelectorAll('.c').forEach(cell => {
                if (filterType === 'all') {
                    cell.style.opacity = '1';
                } else if (filterType === 'conn') {
                    cell.style.opacity = cell.classList.contains('conn') ? '1' : '0.15';
                } else if (filterType === 'alarm') {
                    cell.style.opacity = cell.classList.contains('alarm') ? '1' : '0.15';
                } else if (filterType === 'c-alert') {
                    cell.style.opacity = cell.classList.contains('c-alert') ? '1' : '0.15';
                } else if (filterType === 'empty') {
                    cell.style.opacity = cell.classList.contains('empty') ? '1' : '0.15';
                }
            });
        }

        // =========================================================================
        // 7. COUNTERS & KPI REFRESH
        // =========================================================================
        function updateCounters() {
            const alarms = document.querySelectorAll('.c.alarm').length;
            const conns = document.querySelectorAll('.c.conn').length;
            const alerts = document.querySelectorAll('.c.c-alert').length;

            document.getElementById('kpiAlarms').innerText = alarms.toString().padStart(2, '0');
            document.getElementById('kpiOnline').innerText = conns.toString().padStart(2, '0');
            document.getElementById('kpiAlerts').innerText = alerts.toString().padStart(2, '0');

            // Dynamic Power Calculation (Approx 6.5 kW per operating container)
            const totalActive = conns + alarms + alerts;
            const mw = ((totalActive * 6.5) / 1000).toFixed(2);
            document.getElementById('kpiLoad').innerText = `${mw} MW`;

            // Update row occupancy counters
            for (let r = 1; r <= TOTAL_ROWS; r++) {
                const rowStr = r.toString().padStart(2, '0');
                const rowEl = document.getElementById(`ROW-${STACK_NAME}-${rowStr}`);
                if (rowEl) {
                    const loaded = rowEl.querySelectorAll('.c.conn, .c.alarm, .c.c-alert').length;
                    const stats = document.getElementById(`stats-${rowStr}`);
                    if (stats) stats.innerText = `${loaded} / 36 units`;
                }
            }
        }

        // =========================================================================
        // 8. SIGNALR REAL-TIME TELEMETRY LISTENER
        // =========================================================================
        const connection = new signalR.HubConnectionBuilder()
            .withUrl("/yardHub")
            .withAutomaticReconnect()
            .build();

        connection.on("UpdateContainer", function (id, temp, status) {
            const box = document.getElementById(id);
            if (box) {
                let sClass = status.toLowerCase();
                if (sClass === 'alert') sClass = 'c-alert';

                // Update DOM classes
                box.className = 'c ' + sClass;
                box.setAttribute('data-temp', temp);
                box.setAttribute('data-status', status);
                box.setAttribute('data-tooltip', `${id} | ${temp}°C | ${status}`);

                // If currently selected container is updated, refresh sidebar
                if (selectedUnit.id === id) {
                    selectedUnit.temp = temp;
                    selectedUnit.status = status;
                    updateInspectorUI();
                }

                updateCounters();
            }
        });

        connection.start()
            .then(() => {
                console.log("SignalR Connected to YardHub.");
                document.getElementById('brokerDot').className = 'status-dot pulsing';
                document.getElementById('brokerText').innerText = 'BROKER: CONNECTED';
            })
            .catch(err => {
                console.warn("SignalR Connection Warning:", err);
                document.getElementById('brokerDot').className = 'status-dot bg-warning';
                document.getElementById('brokerText').innerText = 'BROKER: RETRYING...';
            });

        // Initialize clock & yard
        setInterval(() => {
            document.getElementById('clock').innerText = new Date().toLocaleTimeString();
        }, 1000);

        // Build Yard DOM & select initial container
        buildYard();
        handleContainerClick('CONT-AB01-6A');
    </script>
}